# Copy to .env. AI provider keys are set in the web UI (Settings page), not here.

# Optional. NiceGUI session-cookie signing key. Leave unset to have one generated
# on first start and kept in the ankinote-config volume; set it only to manage
# the secret yourself (generate: openssl rand -hex 32).
# ANKINOTE_STORAGE_SECRET=

# AnkiWeb account this collection syncs with. Optional — leave blank and log in
# from the Settings page instead. When set, these take precedence over a UI
# login and the password is never written to disk.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=

# Published address/port (default 127.0.0.1:8080). "8080" binds all interfaces.
# ANKINOTE_PUBLISH=127.0.0.1:8080

# Override the image (default ghcr.io/ignity21/ankinote-ai:latest)
# ANKINOTE_IMAGE=ignity21/ankinote-ai:0.3.1
