# Configuration for the `ankinote` CLI (run from a clone of this repo).
# The web GUI configures AI providers on its Settings page instead — see deploy/
# for the containerized GUI.

# LiteLLM Keys
DEEPSEEK_API_KEY=your_deepseek_key
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
# ANTHROPIC_API_KEY=your_anthropic_key

# Google TTS Key
GOOGLE_TTS_KEY=your_google_tts_key

# Anki Collection
ANKI_BACKEND=collection # connect
ANKI_CONNECT_URL=http://localhost:8765
ANKI_COLLECTION_PATH=~/.local/share/ankinote/collection.anki2
