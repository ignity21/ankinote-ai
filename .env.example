# Configuration for the `ankinote` CLI (run from a clone of this repo).
# Everything below is also configurable from `ankinote` (bare, interactive
# menu) or the web GUI's Settings page, and migrates into settings.json on
# first run — this file only matters before that, or for scripts/CI that
# skip settings.json entirely.

# AI provider keys: uncomment whichever you want litellm to fall back to
# when no provider profile / --profile matches.
# OPENAI_API_KEY=your_openai_key
# DEEPSEEK_API_KEY=your_deepseek_key
# GEMINI_API_KEY=your_gemini_key
# ANTHROPIC_API_KEY=your_anthropic_key
# XAI_API_KEY=your_xai_key

# Google TTS Key
GOOGLE_TTS_KEY=your_google_tts_key

# Anki backend: "connect" (talk to Anki Desktop via AnkiConnect, default) or
# "collection" (in-process, headless, needs ANKI_COLLECTION_PATH below).
ANKI_BACKEND=collection # connect
ANKI_COLLECTION_PATH=~/.local/share/ankinote/collection.anki2

# Where AnkiConnect lives — only used by the "connect" backend, and has no
# Settings-page equivalent (it's read once at client construction time).
ANKI_CONNECT_URL=http://localhost:8765
